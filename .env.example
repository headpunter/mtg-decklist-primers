# Copy this to .env and fill in your values
# cp .env.example .env

# ── Archidekt ──────────────────────────────────────────────────────
# Your Archidekt username — used to auto-import all your public decks
ARCHIDEKT_USERNAME=your_username_here

# Optional: bearer token for private folders/decks
# Get it from browser DevTools → any archidekt.com/api request → Authorization header
# ARCHIDEKT_TOKEN=Bearer xxxxx

# ── AI (at least one required for recommendations + primer builder) ─
# Gemini: free tier at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude: https://console.anthropic.com/
# ANTHROPIC_API_KEY=
